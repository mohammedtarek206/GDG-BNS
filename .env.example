# GDG Event Platform – Environment Variables
# Copy this file to .env.local and fill in the actual values.

# ─── MongoDB Atlas ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gdg-event?retryWrites=true&w=majority

# ─── Session / Auth ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-32-plus-char-random-secret

# ─── QR Ticket Signing ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
QR_SECRET=replace-with-another-32-plus-char-random-secret

# ─── Resend Email API ────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=GDG Event <tickets@yourdomain.com>

# ─── App URL (no trailing slash) ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Cron / Background Job Auth ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-another-random-hex-secret

# ─── Initial Admin Setup (only used by seed script) ──────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
